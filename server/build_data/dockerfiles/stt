FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY server/build_data/requirements/stt.txt ./app/requirements.txt
RUN pip3 install --no-cache-dir -r ./app/requirements.txt
ENV LD_LIBRARY_PATH="/usr/local/lib/python3.10/dist-packages/nvidia/cublas/lib:/usr/local/lib/python3.10/dist-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}"

COPY gigaam ./app/gigaam
COPY utils ./app/utils
COPY server/server.py ./app/server/server.py
ENV PYTHONPATH="/app"
WORKDIR /app/
CMD python3 /app/server/server.py